# Connector URLs identify Fly connections; do not put provider API keys here.
# Public history needs no GitHub credential. The Ollama model still uses a connector.
PASTYOU_GITHUB_PUBLIC=1
# Optional alternative: set a GitHub connector URL to take precedence over public access.
# PASTYOU_GITHUB_CONNECTOR=https://api.sprites.dev/v1/gateway/github/YOUR_CONNECTION_ID
PASTYOU_MODEL_URL=https://api.sprites.dev/v1/gateway/ollama/YOUR_CONNECTION_ID/v1/chat/completions
PASTYOU_MODEL=YOUR_TOOL_CALLING_MODEL
# Required before exposing the app publicly: persistent daily investigation cap.
PASTYOU_DAILY_LIMIT=30
PASTYOU_QUOTA_FILE=/home/sprite/past-you/data/public-usage.json
